{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendoorspecification.org/schemas/operation-catalog.schema.json",
  "type": "object",
  "required": ["schema_version", "spec_version", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "spec_version": {"type": "string"},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stability", "summary", "inputs", "result"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
          "stability": {"enum": ["core", "optional", "experimental"]},
          "summary": {"type": "string", "minLength": 1},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "result": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
