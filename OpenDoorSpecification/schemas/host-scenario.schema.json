{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendoorspecification.org/schemas/host-scenario.schema.json",
  "title": "ODS host simulator scenario",
  "type": "object",
  "required": ["actions"],
  "properties": {
    "session": {
      "type": "object",
      "properties": {
        "identity": {"type": "object"},
        "node": {"type": ["integer", "string"]},
        "time_left": {"type": ["integer", "null"], "minimum": 0},
        "connected": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "keys": {"type": "array", "items": {"type": "string"}},
        "lines": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "command_results": {"type": "object"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation"],
        "properties": {
          "operation": {"type": "string"},
          "arguments": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
