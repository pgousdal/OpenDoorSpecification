{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ODS historical API manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "status",
    "transport",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "inferred",
        "unknown"
      ]
    },
    "transport": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
