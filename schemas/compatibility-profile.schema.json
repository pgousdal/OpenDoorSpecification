{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendoorspecification.org/schemas/compatibility-profile.schema.json",
  "title": "ODS Compatibility Profile Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "profile_version",
    "spec_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "spec_version": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "operation_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
      }
    },
    "text_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "maturity",
        "required_operations",
        "optional_operations",
        "operations_outside_profile",
        "compatibility_expectations",
        "conformance_evidence_expectations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "enum": [
            "draft",
            "stable",
            "deprecated"
          ]
        },
        "required_operations": {
          "$ref": "#/$defs/operation_set",
          "minItems": 1
        },
        "optional_operations": {
          "$ref": "#/$defs/operation_set"
        },
        "operations_outside_profile": {
          "$ref": "#/$defs/operation_set"
        },
        "compatibility_expectations": {
          "$ref": "#/$defs/text_list"
        },
        "conformance_evidence_expectations": {
          "$ref": "#/$defs/text_list"
        }
      },
      "additionalProperties": false
    }
  }
}
