{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendoorspecification.org/schemas/conformance-profile.schema.json",
  "title": "ODS Conformance Profiles",
  "type": "object",
  "required": ["schema_version", "profile_version", "spec_version", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_version": {"type": "string"},
    "spec_version": {"type": "string"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "level", "summary", "required_operations"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "level": {"type": "integer", "minimum": 1},
          "summary": {"type": "string", "minLength": 1},
          "required_operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
