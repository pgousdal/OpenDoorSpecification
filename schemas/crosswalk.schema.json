{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendoorspecification.org/schemas/crosswalk.schema.json",
  "title": "ODS Crosswalk Host Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "milestone",
    "host",
    "operations",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "milestone": {
      "const": "M6.1"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "evidence_class",
        "census_path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "documented-sdk",
            "documented-protocol",
            "wrapper-binding",
            "observed-doors"
          ]
        },
        "census_path": {
          "type": "string",
          "pattern": "^catalog/census/.+\\.json$"
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "status",
          "symbols",
          "evidence_class",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "host": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "operation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "status": {
            "enum": [
              "verified",
              "partial",
              "unassessed"
            ]
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "semantic_review": {
            "enum": [
              "reviewed",
              "provisional",
              "unknown"
            ]
          },
          "evidence_class": {
            "enum": [
              "documented-sdk",
              "documented-protocol",
              "wrapper-binding",
              "observed-doors"
            ]
          },
          "lossiness": {
            "enum": [
              "lossless",
              "lossy",
              "unknown"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "archive",
                "path"
              ],
              "properties": {
                "archive": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^prov\\.[a-z0-9][a-z0-9._-]+$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "verified",
                    "partial"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "id",
                "host",
                "evidence",
                "rationale",
                "limitations"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "partial"
                }
              }
            },
            "then": {
              "properties": {
                "limitations": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
