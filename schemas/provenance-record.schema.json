{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendoorspecification.org/schemas/provenance-record.schema.json",
  "type": "object",
  "required": ["id", "claim_type", "status", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^prov\\.[a-z0-9][a-z0-9._-]+$"},
    "claim_type": {"enum": ["operation-mapping", "abi", "structure", "behavior"]},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
    "api": {"type": "string", "minLength": 1},
    "status": {"enum": ["documented", "observed", "inferred", "unknown"]},
    "summary": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["archive", "path"],
        "properties": {
          "archive": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "symbol": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
